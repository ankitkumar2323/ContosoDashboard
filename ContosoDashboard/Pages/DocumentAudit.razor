@page "/document-audit"
@using System.Security.Claims
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrator")]
@inject DocumentAuditService AuditService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Document Audit - ContosoDashboard</PageTitle>
<div class="container-fluid"><h1>Document activity</h1>
    @if (events.Count == 0) { <p class="text-muted">No document activity is available.</p> } else {
        <div class="table-responsive"><table class="table"><thead><tr><th>When</th><th>Actor</th><th>Document</th><th>Action</th><th>Outcome</th><th>Details</th></tr></thead><tbody>
        @foreach (var item in events) { <tr><td>@item.OccurredDate.ToLocalTime().ToString("g")</td><td>@item.ActorUserId</td><td>@item.DocumentId</td><td>@item.Action</td><td>@item.Outcome</td><td>@item.Details</td></tr> }
        </tbody></table></div>
    }
</div>
@code {
    private List<DocumentAuditEvent> events = new();
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId)) events = await AuditService.GetReportAsync(userId);
    }
}